---
import type { Dict } from '../i18n';
import SmartImage from './SmartImage.astro';

interface Props {
  t: Dict;
}
const { t } = Astro.props;

const items = t.products.items.map((label, i) => ({
  label,
  src: `/images/products/product-${i + 1}.jpg`,
}));
---
<section id="products" class="products">
  <div class="products__wrap">
    <div class="reveal section-header">
      <h2>{t.products.heading.toUpperCase()}</h2>
      <div class="rule"></div>
    </div>

    <div class="products__grid">
      {items.map((p, i) => (
        <div class={`reveal-scale products__cell${i === 0 ? ' is-feature' : ''}`} style={`transition-delay: ${i * 0.06}s`}>
          <SmartImage
            src={p.src}
            alt={p.label}
            label={p.label}
            aspect="1/1"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .products {
    padding: clamp(60px, 8vw, 88px) clamp(20px, 4vw, 56px);
  }
  .products__wrap {
    max-width: 1200px;
    margin: 0 auto;
  }
  .products__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
  }
  .products__cell.is-feature {
    grid-column: span 2;
    grid-row: span 2;
  }
  .products__cell :global(.img-placeholder),
  .products__cell :global(img) {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 900px) {
    .products__grid { grid-template-columns: repeat(2, 1fr); }
    .products__cell.is-feature { grid-column: span 2; grid-row: span 1; }
  }
  @media (max-width: 480px) {
    .products__grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
