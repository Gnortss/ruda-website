---
import type { Dict } from '../i18n';
import SmartImage from './SmartImage.astro';

interface Props {
  t: Dict;
}
const { t } = Astro.props;

const files = ['OR-1.jpg', 'OR-2.jpg', 'OR-8.jpg', 'OR-12.jpg', 'OR-14.jpg', 'OR-15.jpg', 'OR-3.jpg', 'OR-4.jpg', 'OR-5.jpg'];
const items = files.map((file) => ({
  label: t.products.imageAlt,
  src: `/images/products/${file}`,
}));
---
<section id="products" class="products">
  <div class="products__wrap">
    <div class="reveal section-header">
      <h2>{t.products.heading.toUpperCase()}</h2>
      <div class="rule"></div>
    </div>

    <div class="products__grid">
      {items.map((p, i) => (
        <div class={`reveal-scale products__cell${i === 0 ? ' is-feature' : ''}`} style={`transition-delay: ${i * 0.06}s`}>
          <SmartImage
            src={p.src}
            alt={p.label}
            label={p.label}
            aspect="1/1"
          />
        </div>
      ))}
    </div>
  </div>

  <div class="lightbox" id="product-lightbox" hidden>
    <button class="lightbox__close" type="button" aria-label={t.products.closeLabel}>&times;</button>
    <img class="lightbox__img" src="" alt="" />
  </div>
</section>

<style>
  .products {
    padding: clamp(60px, 8vw, 88px) clamp(20px, 4vw, 56px);
  }
  .products__wrap {
    max-width: 1200px;
    margin: 0 auto;
  }
  .products__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
  }
  .products__cell.is-feature {
    grid-column: span 2;
    grid-row: span 2;
  }
  .products__cell :global(.img-placeholder),
  .products__cell :global(img) {
    width: 100%;
    height: 100%;
  }
  .products__cell :global(img) {
    cursor: pointer;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(20, 20, 20, 0.92);
  }
  .lightbox[hidden] {
    display: none;
  }
  .lightbox__img {
    max-width: 92vw;
    max-height: 92vh;
    object-fit: contain;
  }
  .lightbox__close {
    position: fixed;
    top: 20px;
    right: 24px;
    width: 44px;
    height: 44px;
    font-size: 32px;
    line-height: 1;
    color: #fff;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  @media (max-width: 900px) {
    .products__grid { grid-template-columns: repeat(2, 1fr); }
    .products__cell.is-feature { grid-column: span 2; grid-row: span 1; }
  }
  @media (max-width: 480px) {
    .products__grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
  const lightbox = document.getElementById('product-lightbox');
  const lightboxImg = lightbox?.querySelector<HTMLImageElement>('.lightbox__img');
  const closeBtn = lightbox?.querySelector<HTMLButtonElement>('.lightbox__close');
  const cellImages = document.querySelectorAll<HTMLImageElement>('.products__cell img');

  // Move the overlay to <body> so its position:fixed can never be trapped by an
  // ancestor's transform/overflow/stacking context.
  if (lightbox) document.body.appendChild(lightbox);

  function open(img: HTMLImageElement) {
    if (!lightbox || !lightboxImg) return;
    lightboxImg.src = img.src;
    lightboxImg.alt = img.alt;
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  function close() {
    if (!lightbox || !lightboxImg) return;
    lightbox.hidden = true;
    lightboxImg.src = '';
    document.body.style.overflow = '';
  }

  cellImages.forEach((img) => img.addEventListener('click', () => open(img)));
  closeBtn?.addEventListener('click', close);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) close();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightbox && !lightbox.hidden) close();
  });
</script>
